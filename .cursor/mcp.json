{
  "mcpServers": {
    "look-mum-no-hands": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "${workspaceFolder}/plugins/look-mum-no-hands/scripts/run-lmnh-mcp.sh"
      ],
      "env": {
        "LMNH_REPO_ROOT": "${workspaceFolder}",
        "LMNH_LOG_LEVEL": "debug",
        "LMNH_OVERLAY_RENDERER": "headless"
      }
    }
  }
}
